# ---------------------------------------------------------------------------
# Copia este archivo como .env y llena los valores. NUNCA subas .env a Git.
# ---------------------------------------------------------------------------

# Puerto de la API
PORT=3000

# Origen permitido para el frontend (CORS)
CORS_ORIGEN=http://localhost:5173
URL_REGISTRO_BASE=http://localhost:5173/r

# Conexión de la API: SIEMPRE con api_campana, nunca con postgres
DB_HOST=localhost
DB_PORT=5432
DB_NOMBRE=campana_gobernacion
DB_USUARIO=api_campana
DB_CLAVE=cambia-esta-clave

# Solo para regenerar los tipos (npm run db:tipos). Usa postgres porque
# necesita leer la estructura completa de la base; no lo usa la API.
CODEGEN_DATABASE_URL=postgres://postgres:cambia-esta-clave@localhost:5432/campana_gobernacion

# Autenticación. JWT_SECRETO firma los tokens de sesión: mínimo 32 caracteres
# aleatorios, distinto en cada ambiente. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRETO=cambia-este-secreto-por-uno-largo-y-aleatorio
# Duración de la sesión (ej. 30m, 8h)
JWT_DURACION=8h

# Protección de datos personales. Ambas claves deben ser aleatorias, base64 y
# generadas fuera del repositorio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PEPPER_HMAC=cambia-por-una-clave-base64-de-32-bytes
LLAVE_CIFRADO=cambia-por-una-clave-base64-de-32-bytes
