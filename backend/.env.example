# ---------------------------------------------------------------------------
# Copia este archivo como .env y llena los valores. NUNCA subas .env a Git.
# ---------------------------------------------------------------------------

# Puerto de la API
PORT=3000

# Orígenes permitidos para el frontend (CORS), separados por coma, sin
# espacios (ej. https://campana.co,https://admin.campana.co)
CORS_ORIGENES=http://localhost:5173

URL_REGISTRO_BASE=http://localhost:5173/r

# true solo detrás de un proxy de confianza (p. ej. Cloudflare) en producción,
# para que la IP real del visitante llegue a la API (límite de peticiones,
# bloqueo por intentos fallidos, auditoría). En desarrollo déjalo en false:
# si lo activas sin un proxy real, cualquiera puede falsificar su IP con la
# cabecera X-Forwarded-For.
TRUST_PROXY=false

# Conexión de la API: SIEMPRE con api_campana, nunca con postgres
DB_HOST=localhost
DB_PORT=5432
DB_NOMBRE=campana_gobernacion
DB_USUARIO=api_campana
DB_CLAVE=cambia-esta-clave

# Solo para regenerar los tipos (npm run db:tipos). Usa postgres porque
# necesita leer la estructura completa de la base; no lo usa la API.
CODEGEN_DATABASE_URL=postgres://postgres:cambia-esta-clave@localhost:5432/campana_gobernacion

# Autenticación. JWT_SECRETO firma el token de acceso (cookie campana_acceso,
# siempre dura 15 minutos, fijo): mínimo 32 caracteres aleatorios, distinto en
# cada ambiente. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRETO=cambia-este-secreto-por-uno-largo-y-aleatorio

# Cookies de sesión (httpOnly, SameSite=Strict). COOKIE_SEGURA=true exige HTTPS
# (el navegador nunca las manda por http://): actívala solo en producción, o
# en local si ya sirves con HTTPS. En desarrollo por http://localhost, false.
COOKIE_SEGURA=false
# Duración de la cookie de renovación (campana_renovacion) en horas. Se rota
# en cada uso; si se reutiliza una ya rotada, la sesión se cierra (robo).
RENOVACION_HORAS=12

# Protección de datos personales. Ambas claves deben ser aleatorias, base64 y
# generadas fuera del repositorio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PEPPER_HMAC=cambia-por-una-clave-base64-de-32-bytes
LLAVE_CIFRADO=cambia-por-una-clave-base64-de-32-bytes

# ---------------------------------------------------------------------------
# SOLO PARA LAS PRUEBAS e2e DE SEGURIDAD (backend/test/seguridad.e2e-spec.ts).
# No se necesitan para correr la API. Requieren la base de desarrollo (usa
# CODEGEN_DATABASE_URL de arriba para crear las cuentas) con database/07 y
# 08_datos_demo.sql cargados.
#
# Son cuentas EXCLUSIVAS de las pruebas, con login "prueba.*": la propia
# suite las crea (si no existen), les asigna estas contraseñas y las borra
# por completo al terminar (test/cuentas-prueba.ts) — no hace falta correr
# `npm run usuario:clave`. NUNCA se tocan las cuentas de demostración
# (gerente@demo.co, coord.*@demo.co, lider*@demo.co); tampoco uses aquí
# credenciales reales de producción.
# ---------------------------------------------------------------------------
TEST_PRUEBA_GERENTE_LOGIN=prueba.gerente@demo.co
TEST_PRUEBA_GERENTE_CLAVE=

TEST_PRUEBA_COORDINADORA_LOGIN=prueba.coordinadora@demo.co
TEST_PRUEBA_COORDINADORA_CLAVE=

TEST_PRUEBA_LIDER_LOGIN=prueba.lider@demo.co
TEST_PRUEBA_LIDER_CLAVE=

# Cuenta dedicada solo a la prueba de bloqueo por intentos fallidos.
TEST_PRUEBA_BLOQUEO_LOGIN=prueba.bloqueo@demo.co
TEST_PRUEBA_BLOQUEO_CLAVE=

# Captcha del registro público (Cloudflare Turnstile). Crea el widget en
# https://dash.cloudflare.com -> Turnstile y copia las dos claves. Opcional en
# desarrollo; OBLIGATORIO en producción (COOKIE_SEGURA=true).
# Claves de prueba de Cloudflare que siempre aprueban (solo para desarrollo):
#   TURNSTILE_SITEKEY=1x00000000000000000000AA
#   TURNSTILE_SECRETO=1x0000000000000000000000000000000AA
TURNSTILE_SITEKEY=
TURNSTILE_SECRETO=

# Inteligencia artificial (Claude, de Anthropic). Opcional.
# Clasifica las necesidades (vías, agua, salud...) y genera el informe de
# necesidades por municipio. Sin clave, las necesidades se clasifican con
# reglas por palabras clave y el informe con IA no se ofrece.
# Clave en https://console.anthropic.com -> API Keys. NUNCA la subas a Git.
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-opus-5)
IA_MODELO=claude-opus-5

# Responsable del tratamiento de los datos (Ley 1581). Aparece en la página
# pública de privacidad y en el canal para ejercer los derechos. Opcionales,
# pero en producción deben estar: el titular debe saber a quién dirigirse.
RESPONSABLE_NOMBRE=Campaña a la Gobernación del Caquetá
RESPONSABLE_CORREO=
RESPONSABLE_TELEFONO=
